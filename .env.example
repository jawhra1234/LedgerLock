# Copy this file to .env and fill in your key. .env is gitignored.
#
#   cp .env.example .env
#
# Get a key from https://aistudio.google.com/apikey -- free, no card needed.
# The key is only required to REGENERATE cached model responses
# (`run --upto t3 --llm live`). Reproducing the published numbers needs no key:
# the responses are committed under data/llm_cache/.

GEMINI_API_KEY=

# The model id, exactly as it appears in Google AI Studio. Kept in config so
# swapping providers or model tiers is a one-line change -- the model does
# ~3.5% of the work in this pipeline and nothing structural depends on it.
LEDGERLOCK_LLM_MODEL=
